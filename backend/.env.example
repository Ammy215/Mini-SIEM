# ---- App ----
APP_ENV=development
# Signs every login token. Production refuses to start with this placeholder or
# anything under 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_long_random_string
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
# Only used for CORS when the frontend calls the API from another origin. With
# the /api proxy (Vite locally, Vercel in production) requests are same-origin.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Detection ----
# Seconds between scheduled detection passes.
DETECTION_INTERVAL_SECONDS=60

# ---- Ingestion limits (optional; defaults shown) ----
MAX_UPLOAD_BYTES=10485760
MAX_INGEST_BODY_BYTES=5242880

# ---- Database ----
DATABASE_URL=postgresql://siem:siem@localhost:5432/mini_siem

# ---- Admin seed (used ONCE by scripts/seed_admin.py) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# ---- Threat intel (all free) ----
ABUSEIPDB_API_KEY=
OTX_API_KEY=
IPINFO_TOKEN=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=

# ---- Context signals (blank = not configured, signal skipped) ----
# HOME_COUNTRIES: two-letter codes; alerts from other countries get foreign_geo (+5)
HOME_COUNTRIES=
# BUSINESS_HOURS like 08:00-18:00; alerts outside them get after_hours (+5)
BUSINESS_HOURS=
BUSINESS_DAYS=mon-fri
BUSINESS_TIMEZONE=UTC
# Background country lookups for event source IPs (ipinfo, 25 per detection tick)
ENABLE_GEO_LOOKUPS=true

# ---- Live syslog listener: LOCAL LAB ONLY, keep false in production ----
# Receives syslog over UDP and TCP. Syslog has no authentication and UDP
# senders can be forged, so only listed sources are accepted.
ENABLE_SYSLOG_LISTENER=false
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514
# Required when enabled, e.g. 127.0.0.1/32,192.168.1.0/24
SYSLOG_ALLOWED_SOURCES=
SYSLOG_RATE_PER_SECOND=200
SYSLOG_BURST=1000

# ---- Optional AI (opt-in "Summarize with AI" on alerts/incidents) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- DEV-ONLY attack lab. MUST stay false/unset in production ----
ENABLE_ATTACK_LAB=false

# ---- Proxy lock (production) ----
# Same value as INTERNAL_PROXY_SECRET on Vercel. When set, every request except
# /api/health must carry it (Vercel's middleware adds it), so the Render URL
# can't be hit directly. Blank = off. Generate like SECRET_KEY.
INTERNAL_PROXY_SECRET=
