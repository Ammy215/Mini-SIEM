# ---- App ----
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_string
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173

# ---- Ingestion limits (optional; defaults shown) ----
MAX_UPLOAD_BYTES=10485760
MAX_INGEST_BODY_BYTES=5242880

# ---- Database ----
DATABASE_URL=postgresql://siem:siem@localhost:5432/mini_siem

# ---- Admin seed (used ONCE by scripts/seed_admin.py) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# ---- Threat intel (all free) ----
ABUSEIPDB_API_KEY=
OTX_API_KEY=
IPINFO_TOKEN=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=

# ---- Optional AI (opt-in "Summarize with AI" on alerts/incidents) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- DEV-ONLY attack lab. MUST stay false/unset in production ----
ENABLE_ATTACK_LAB=false
